<%- include('header') %>

<h1 style="color: #6d8e7c; font-style: italic; text-align: center;">Tree Shop</h1>
<form action="/add" method="POST" style="margin-bottom: 30px;">
    <div style="margin-bottom: 10px;">
        <label>Tree Name:</label><br>
        <input type="text" name="treename" style="width: 300px; padding: 5px;" required>
    </div>
    <div style="margin-bottom: 10px;">
        <label>Description:</label><br>
        <textarea name="description" style="width: 300px; padding: 5px;" rows="3" required></textarea>
    </div>
    <div style="margin-bottom: 10px;">
        <label>Image Path (Ví dụ: D:/image/phonglan.png):</label><br>
        <input type="text" name="image" style="width: 300px; padding: 5px;">
    </div>
    <button type="submit" style="background: #6f9c80; color: white; padding: 8px 15px; border: none; cursor: pointer;">Add</button>
    <button type="reset" style="background: #9f5b61; color: white; padding: 8px 15px; border: none; cursor: pointer;">Reset</button> 
</form>
<hr>
<table border="1" style="width: 100%; border-collapse: collapse; margin-top: 20px;">
    <tr style="background-color: #769584; color: white;">
        <th style="padding: 10px;">Id</th>
        <th style="padding: 10px;">Name</th>
        <th style="padding: 10px;">Image</th>
        <th style="padding: 10px;">Description</th>
    </tr>
    <% for(let i = 0; i < trees.length; i++) { %>
    <tr>
        <td style="padding: 10px; text-align: center;"><%= i + 1 %></td>
        <td style="padding: 10px;"><%= trees[i].treename %></td>
        <td style="padding: 10px;"><%= trees[i].image %></td>
        <td style="padding: 10px;"><%= trees[i].description %></td>
    </tr>
    <% } %>
</table>

<%- include('footer') %>